{
  "name": "agent-canvas",
  "version": "1.0.0",
  "description": "Visual Multi-Agent Orchestrator & Transpiler for Universal Markdown (.md) AI Agents",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/**/*.test.js",
