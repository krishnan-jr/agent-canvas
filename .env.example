# ==============================================================================
# Agent Canvas - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Local Endpoints
# ------------------------------------------------------------------------------
# Port for the web application, REST API, and VitePress docs (Default: 3000)
PORT=3000

# Host interface to bind server (Default: 0.0.0.0 or 127.0.0.1)
HOST=0.0.0.0

# Node environment: 'development' | 'production'
NODE_ENV=development

# Base Application URL (Used for external MCP client callbacks & SSE URLs)
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Persistence & File Storage
# ------------------------------------------------------------------------------
# Custom path for local data directory (Default: ./data)
DATA_DIR=./data

# Custom path for SQLite database file (Default: ./data/canvas.db)
DATABASE_PATH=./data/canvas.db

# Directory for on-disk mirrored agent vaults and workspace exports (Default: ./workspace)
WORKSPACE_DIR=./workspace

# ------------------------------------------------------------------------------
# 3. Model Context Protocol (MCP) Server Endpoints
# ------------------------------------------------------------------------------
# Server identifier advertised to connecting MCP clients
MCP_SERVER_NAME=agent-canvas

# Transport mode: 'stdio' (CLI subprocess) | 'sse' (HTTP EventStream)
MCP_TRANSPORT=stdio

# Remote MCP SSE Stream endpoint (Read-only GET stream)
# MCP_SSE_ENDPOINT=http://localhost:3000/api/mcp/sse

# Remote MCP JSON-RPC Message endpoint (POST endpoint)
# MCP_MESSAGE_ENDPOINT=http://localhost:3000/api/mcp/message

# ------------------------------------------------------------------------------
# 4. LLM API Keys & Custom Multi-Model Lists
# ------------------------------------------------------------------------------
# Google Gemini (Google AI Studio / Vertex AI)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-3.7-flash,gemini-3.7-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-3-7-sonnet,claude-3-5-sonnet,claude-3-5-haiku

# OpenAI (Official API or OpenAI-compatible custom inference)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o,gpt-4o-mini,o3-mini

# OpenRouter (Unified multi-model API proxy)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=anthropic/claude-3.7-sonnet,google/gemini-2.5-pro,openai/gpt-4o

# Local & Self-Hosted LLM Inference Endpoints (Ollama, vLLM, LM Studio, LocalAI)
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.3,qwen2.5-coder,deepseek-r1

LM_STUDIO_BASE_URL=
LM_STUDIO_MODELS=local-model

VLLM_BASE_URL=
VLLM_MODELS=meta-llama/Llama-3.3-70B-Instruct


# ------------------------------------------------------------------------------
# 5. Agent Execution Defaults
# ------------------------------------------------------------------------------
# Default model identifier for newly created agent blocks
DEFAULT_MODEL=gemini-2.5-flash

# Default temperature for sampling (0.0 to 1.0)
DEFAULT_TEMPERATURE=0.2
